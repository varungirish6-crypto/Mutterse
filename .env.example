# ==============================================================================
# MUTTERSE APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running or building the project:
#   cp .env.example .env
#
# Replace the placeholder values below with your verified credentials.
# NEVER commit your actual '.env' file or production API keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Required for AI prescription scanning, medicine label OCR, safety triage,
# and the maternal AI chat assistant.
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port for the standalone Node.js Gemini AI proxy server (default: 3001)
PORT=3001

# ------------------------------------------------------------------------------
# 2. Frontend Backend API Base URL
# ------------------------------------------------------------------------------
# Controls how the frontend connects to the Gemini AI proxy service:
#
# • Web Dev (Browser / Vite):
#   Leave EMPTY. The Vite dev server will proxy `/api/gemini` requests automatically.
#
# • Android Emulator:
#   http://10.0.2.2:3001
#
# • Android Physical Device (via Wi-Fi):
#   http://<YOUR_LOCAL_IP>:3001  (e.g., http://192.168.1.100:3001)
#   Find your IP on Windows using: `ipconfig` -> IPv4 Address
#   Note: Rebuild and sync after changing this value: `pnpm build && npx cap sync android`
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database & Authentication
# ------------------------------------------------------------------------------
# Required for user authentication (Email/Password, Google OAuth) and real-time
# maternal data persistence (profiles, vitals, care tasks, appointments).
# Obtain these from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
